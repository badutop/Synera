# Copie ce fichier en ".deploy.env" (déjà gitignoré) et remplis les valeurs réelles.
# Ne commite jamais ".deploy.env" — seul ce .example doit rester dans git.

# --- FTP (onglet "FTP-SSH" de l'hébergement OVH) ---
FTP_HOST=ftp.clusterXXX.hosting.ovh.net
FTP_PORT=21
FTP_USER=
FTP_PASS=

# --- Répertoire cible pour synera-groupe.com (onglet "Multisite" OVH) ---
# Ex: /synera-groupe.com  (chemin relatif à la racine FTP)
REMOTE_DIR=

# --- Base de données MySQL (onglet "Bases de données" OVH) ---
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# --- URL finale du site ---
SITE_URL=https://synera-groupe.com
